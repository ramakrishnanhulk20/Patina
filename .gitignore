# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# database backups and the tooling that makes them. Real user data, never committed.
/scripts/backup-*.mjs
/backup-*.json
/backup-*.csv

# stray local scratch scripts
.tmp-*

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no real values and documents setup.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app identity key material, never commit
.app-identity.txt

# local editor/tooling config, kept off the public repo
CLAUDE.md
AGENT-RETROS.md
.claude/

# separate dist dir so verification builds do not corrupt the dev server
/.next-verify/

# design reference, never ship
/ray-cash website/

