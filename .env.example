# Copy to .env.local for local development. Never commit the real file.
#
# Only VANA_APP_PRIVATE_KEY and VANA_APP_URL are required to run the app at all.
# Everything else degrades to a documented, visible fallback rather than to a
# crash, and /api/health reports which ones are missing on a live deployment.

# --- Vana app identity (required) --------------------------------------------
# An EVM private key for the app itself, NOT a user wallet. Generate it locally,
# then register it from account.vana.org/developers ("Use existing app identity")
# and run: npm run register:moksha  (or register:mainnet)
#
# This key HOLDS AND SPENDS THE ESCROW BALANCE. Treat it as money.
VANA_APP_PRIVATE_KEY=0x...

# The origin the app runs on. This is baked into the app identity registration,
# so it has to match the deployment exactly.
#   local:      http://localhost:3000
#   production: https://patinadata.xyz
VANA_APP_URL=http://localhost:3000

# Leave as production. This selects the live Vana approval surface, not the
# network; VANA_NETWORK below picks the chain.
VANA_ENV=production

# moksha = testnet (free, faucet VANA). mainnet = real, pays a fee per read and
# is the ONLY network where Vana Cup points are scored.
# Unset defaults to mainnet (same as Vana's Career Quest / data-app-starter).
VANA_NETWORK=moksha

# --- Signing scores ----------------------------------------------------------
# A SECOND, SEPARATE private key, used only to sign score attestations.
#
# Unset, Patina falls back to VANA_APP_PRIVATE_KEY and keeps working, and the
# admin page says so. That fallback is what you are trying to get away from:
# with one key doing both jobs, a leak drains the escrow AND lets somebody forge
# Patina's signature on any claim about anybody. Signing needs no funds, so this
# key can be generated and then left alone forever.
#
#   openssl rand -hex 32   (then prefix with 0x)
#
# Changing it changes the address every attestation verifies against, so update
# PATINA_APP_ADDRESS in src/lib/patina-address.ts in the same change.
PATINA_ATTESTATION_KEY=

# --- Storage -----------------------------------------------------------------
# Either naming scheme works, and you do not need both:
#
#   UPSTASH_REDIS_REST_URL / _TOKEN       Upstash's own convention
#   KV_REST_API_URL / KV_REST_API_TOKEN   what Vercel's Upstash integration sets
#
# On Vercel the integration injects the KV_* pair automatically, so there is
# nothing to paste. Locally, copy either pair from the Upstash dashboard.
#
# With neither set, the app runs on in-memory storage and loses every profile
# when the process restarts, and counts nothing. Check /api/health to see which
# you are on: it does a real write-then-read rather than trusting the variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Identity hashing --------------------------------------------------------
# The secret that keys the hash of each user's Personal Server URL, which is how
# a profile follows somebody between devices without anybody signing in.
#
# Unset, it falls back to VANA_APP_PRIVATE_KEY, so a missing value degrades to
# "still hashed, still keyed" rather than to plaintext. Setting it properly
# means the identity index survives rotating the app key.
#
#   openssl rand -hex 32
PATINA_IDENTITY_SECRET=

# --- Admin -------------------------------------------------------------------
# The password for /admin, which shows the funnel, the user numbers and how much
# escrow balance is left.
#
# Unset, /admin and /api/admin/* return 404 and no dashboard exists. It fails
# closed on purpose: the opposite default would publish the numbers to anybody
# who guessed the path.
#
#   openssl rand -hex 16
ADMIN_PASSWORD=

# --- Bot protection (ALTCHA) -------------------------------------------------
# An invisible proof-of-work check on the connect endpoint, so a script cannot
# spend the escrow in a loop. Self-hosted: this one key signs and verifies the
# challenges on our own server, nothing is sent to Google or hCaptcha.
#
# Unset, the check is SKIPPED and connecting still works (unprotected), so you
# can deploy the code first and switch protection on by adding this key. Check
# /api/health to see whether it is active. Generate a key with:
#
#   openssl rand -hex 32
ALTCHA_HMAC_KEY=
