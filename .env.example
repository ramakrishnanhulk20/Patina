# Copy to .env.local for local development. Never commit the real file.

# --- Vana app identity -------------------------------------------------------
# An EVM private key for the app itself, NOT a user wallet. Generate it locally,
# then register it from account.vana.org/developers ("Use existing app identity")
# and run: npm run register:moksha  (or register:mainnet)
VANA_APP_PRIVATE_KEY=0x...

# The origin the app runs on. This is baked into the app identity registration,
# so it has to match the deployment exactly.
#   local:      http://localhost:3000
#   production: https://patinadata.xyz
VANA_APP_URL=http://localhost:3000

# Leave as production. This selects the live Vana approval surface, not the
# network; VANA_NETWORK below picks the chain.
VANA_ENV=production

# moksha = testnet (free, faucet VANA). mainnet = real, pays $0.01 USDC.e a read
# and is the ONLY network where Vana Cup points are scored.
VANA_NETWORK=moksha

# --- Storage -----------------------------------------------------------------
# Either naming scheme works, and you do not need both:
#
#   UPSTASH_REDIS_REST_URL / _TOKEN   Upstash's own convention
#   KV_REST_API_URL / KV_REST_API_TOKEN   what Vercel's Upstash integration sets
#
# On Vercel the integration injects the KV_* pair automatically, so there is
# nothing to paste. Locally, copy either pair from the Upstash dashboard.
#
# With neither set, the app runs on in-memory storage and loses every profile
# when the process restarts. Check /api/health to see which you are on.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
