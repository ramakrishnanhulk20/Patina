{
  "name": "patina",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "verify": "npm run typecheck && npm run test && cross-env NEXT_DIST_DIR=.next-verify next build",
